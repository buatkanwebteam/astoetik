# Public URL of the deployed site. It is encoded inside every QR code.
NEXT_PUBLIC_SITE_URL=https://asterax.my.id
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini API (free tier). Create the key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Dashboard login. Set USE_SUPABASE_AUTH=true to use a Supabase Auth user instead.
USE_SUPABASE_AUTH=false
DEMO_ADMIN_EMAIL=admin
DEMO_ADMIN_PASSWORD=admin
SESSION_SECRET=ganti-dengan-string-acak
NEXT_PUBLIC_WA_NUMBER=6281325131111
